---
import { CollectionEntry, getCollection, render } from "astro:content";
import { HiOutlineExternalLink, HiOutlineStar } from "react-icons/hi";
import { RiGithubLine } from "react-icons/ri";
import { ProjectType } from "@/components/Project";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { ButtonGroup } from "@/components/ui/button-group";
import { Card, CardContent } from "@/components/ui/card";
import Main from "@/layouts/Main.astro";
import { getReadme, getStars } from "@/lib/github";
import markdown from "@/lib/markdown";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { name: project.id },
		props: { project },
	}));
}

const { project: raw }: { project: CollectionEntry<"projects"> } = Astro.props;

const project = { slug: raw.id, ...raw.data } as ProjectType;

const readme = await getReadme(
	project.github.split("/").at(-1) ?? "",
	project.github.split("/").at(-2) ?? "",
);
const stars = await getStars(project.github);

const { Content } = await render(raw);
---
<Main title={project.title}>
  <div class="flex flex-col justify-between m-auto mt-20 gap-2 md:w-3/4 relative">
    <div class="flex gap-2 w-full">
      <div class="flex flex-col w-full grow">
        <h1 class="sm:text-6xl text-5xl font-bold md:p-5 p-3 pb-0 w-full">{project.title}</h1>
        <p class="text-md text-muted-foreground md:px-5 p-3 pt-0 w-full">{project.description}</p>
      </div>
      <div class="p-6 flex flex-col gap-4 items-end w-full shrink-2">
        <ButtonGroup className="max-w-full">
          {project.url && <Button is="div" nativeButton={false} variant="outline">
            <a class="flex gap-2 items-center w-full" target="_blank" rel="noopener noreferrer" aria-label="Open page" href={['http', 'https', '//'].some((s) => project.url.startsWith(s)) ? project.url : 'https://'.concat(project.url)}>
              <HiOutlineExternalLink size={18} /> Open Website
            </a>
          </Button>}
          {project.public && <Button is="div" nativeButton={false} variant="outline">
            <a class="flex gap-2 items-center w-full" target="_blank" rel="noopener noreferrer" aria-label="Open github repository" href={project.github}>
              <RiGithubLine data-icon="inline-start" size={18} /> Open GitHub
            </a>
          </Button>}
          {project.public && <Button is="div" nativeButton={false} variant="outline">
            <a class="flex gap-2 items-center w-full" target="_blank" rel="noopener noreferrer" aria-label="Stars"href={project.github + "/stargazers"}>
              <HiOutlineStar data-icon="inline-start" size={18} />
              {stars}
            </a>
          </Button>}
        </ButtonGroup>
        <div class="flex flex-row md:flex-wrap gap-2 justify-start">
          {
            project.topics.map((t) => (
              <a target="_blank" rel="noopener noreferrer" href={`https://github.com/topics/${t}`}><Badge>{t}</Badge></a>
            ))
          }
        </div>
      </div>
    </div>
    <div class="md:px-5 px-3 pb-10">
      <Content />
    </div>
    <Card>
      <CardContent className="markdown" set:html={markdown(readme)} />
    </Card>
  </div>
</Main>