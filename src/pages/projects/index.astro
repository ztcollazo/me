---
import { getCollection } from "astro:content";
import { SectionLabel } from "@/components/About";
import Project from "@/components/Project";
import Main from "@/layouts/Main.astro";

const projects = (await getCollection("projects")).map((project) => {
	return { slug: project.id, ...project.data };
});
---

<Main title="Projects">
  <div class="flex flex-col justify-start w-full p-3 h-full mx-auto mt-20 md:w-3/4 max-w-full relative">
    <SectionLabel>My work</SectionLabel>
    <h1 class="sm:text-6xl text-5xl font-bold mb-10">Projects</h1>
    <ul class="flex flex-col max-w-full md:grid md:grid-cols-2 2xl:grid-cols-3 gap-4">
      {projects.map((project) => <Project project={project} />)}
    </ul>
  </div>
</Main>