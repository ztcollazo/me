---
import "@/styles/globals.css";
import "highlight.js/styles/github-dark.css";
import Footer from "../components/Footer.astro";
import { Header } from "../components/Header";

export interface Props {
	title?: string;
}

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width">
	<title>{title ? `${title} | Zachary Collazo` : 'Zachary Collazo'}</title>
	<link rel="icon" type="image/x-icon" href="/favicon.ico" />
</head>
<body class="min-h-screen flex flex-col bg-background">
	<div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0"
        style={{
          backgroundImage:
            'linear-gradient(oklch(0.25 0.008 260 / 0.35) 1px, transparent 1px), linear-gradient(90deg, oklch(0.25 0.008 260 / 0.35) 1px, transparent 1px)',
          backgroundSize: '60px 60px',
        }}
      />
	  <div
        aria-hidden="true"
        class="pointer-events-none absolute -left-40 top-1/4 h-120 w-120 rounded-full"
        style={{
          background:
            'radial-gradient(circle, oklch(0.65 0.22 250 / 0.12) 0%, transparent 70%)',
        }}
      />
	<Header client:load />
	<main class="max-w-full flex grow h-full gap-5 items-center">
		<slot />
	</main>
	<Footer />
</body>
</html>